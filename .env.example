# ---- Option A: OpenRouter (any vision model) ----
# Get a key at https://openrouter.ai/keys
# Pick any vision-capable model from https://openrouter.ai/models
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-your-openrouter-key-here
AI_MODEL=google/gemini-2.5-flash
# Other good vision models on OpenRouter:
#   AI_MODEL=openai/gpt-4o-mini
#   AI_MODEL=anthropic/claude-3.5-sonnet
#   AI_MODEL=meta-llama/llama-3.2-90b-vision-instruct
#   AI_MODEL=microsoft/qwen-2-vl-72b-instruct

# ---- Option B: Moonshot AI (Kimi) ----
# Get a key at https://platform.moonshot.ai
# AI_BASE_URL=https://api.moonshot.ai/v1
# AI_API_KEY=sk-your-moonshot-key-here
# AI_MODEL=kimi-k3

# (Backward compatible: MOONSHOT_API_KEY / MOONSHOT_MODEL still work if
#  AI_API_KEY / AI_MODEL are not set.)

# Server port (frontend proxies /api here)
PORT=8787
